# Synthetic directory of the ldap module. Every name, number, address, and password is invented.
# The mail domain and the suffix lie under the reserved .test top level domain.
# A bind compares the password with userPassword, and no search ever returns that attribute.
dn:
objectClass: top
namingContexts: dc=example,dc=test
supportedLDAPVersion: 3
supportedSASLMechanisms: PLAIN
subschemaSubentry: cn=Subschema
vendorName: FixingPoint synthetic directory
vendorVersion: 1.0

dn: dc=example,dc=test
objectClass: top
objectClass: domain
dc: example
description: Example Test Corporation

dn: ou=People,dc=example,dc=test
objectClass: top
objectClass: organizationalUnit
ou: People

dn: ou=Groups,dc=example,dc=test
objectClass: top
objectClass: organizationalUnit
ou: Groups

