# SPDX-License-Identifier: GPL-3.0-only
[Unit]
Description=FixingPointSystem agent
Documentation=https://github.com/alrawi/FixingPointSystem/blob/main/image/README.md
After=fps-controller.service fps-mgmt-addr.service fps-role.service fps-tune.service
Requires=fps-mgmt-addr.service
Wants=fps-controller.service fps-tune.service
# fps-role writes the marker for the roles that run the agent. fps-tune writes the
# reboot marker when the kernel options of the agent profile need a reboot.
ConditionPathExists=/run/fps/role.d/fps-agent.service
ConditionPathExists=!/run/fps/tune-reboot

[Service]
Type=simple
# The agent moves test interfaces into network namespaces and binds pool
# addresses, so it runs as root.
# The plus sign runs the token step as root. It never puts a token on a command line.
ExecStartPre=+/usr/libexec/fps/fps-enroll-token
ExecStart=/usr/libexec/fps/fps-agent-start
# The key, the certificate, and the enrollment token of the agent (mutual TLS).
StateDirectory=fps-agent
StateDirectoryMode=0700
Restart=always
LimitNOFILE=4194304
RestartSec=5
# Exit code 2 is a usage error, a kernel before Linux 6.3, or a failure of mutual
# TLS that redialing cannot fix (a wrong CA, a refused token, no token), which a
# restart cannot fix either. Write a new token and restart the unit.
RestartPreventExitStatus=2
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
