#
# Settings of fps-agent.service. The file is sourced by /usr/libexec/fps/fps-agent-start.
FPS_AGENT_ID=local
# Empty means http://<address of mgmt0>:8444, the controller on this VM.
FPS_CONTROLLER_URI=
# Space separated KEY=VALUE labels that the agent reports.
FPS_AGENT_LABELS="role=all-in-one"
# Extra arguments of fps-agent connect, for example "--redial-limit 0".
FPS_AGENT_EXTRA_ARGS=""
