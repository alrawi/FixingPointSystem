#cloud-config
# Example NoCloud user-data for the FixingPointSystem appliance. Replace the key
# with your own public key, then build the seed disk with
#   cloud-localds seed.img user-data meta-data
# and attach seed.img to the VM as a second disk.
ssh_authorized_keys:
  - ssh-ed25519 AAAA...replace-with-your-public-key you@example
# Optional: choose the admin API token. Without this block the controller makes a
# random one on its first start, and `sudo cat /etc/fps/admin.token` shows it.
# write_files:
#   - path: /etc/fps/admin.token
#     owner: root:fps
#     permissions: "0640"
#     content: change-me-to-a-long-random-token
# Optional: choose the role of the VM (IMG-02). Without /etc/fps/role.env the VM is
# an all-in-one lab, which runs the controller and the agent. Put the block below
# into one write_files list together with the token block above.
#
#   controller   runs only fps-controller; no tuning
#   agent        runs only fps-agent against FPS_CONTROLLER_URI; hugepages and CPU
#                isolation, sized from the CPUs and memory, and one automatic reboot
#                on the first boot to apply them
#   all-in-one   both services, sysctls only (the default)
#
# write_files:
#   - path: /etc/fps/role.env
#     permissions: "0644"
#     content: |
#       FPS_ROLE=agent
#       FPS_CONTROLLER_URI=http://192.0.2.10:8444
#       # Optional: FPS_AGENT_ID, FPS_AGENT_LABELS="role=agent site=lab", FPS_AGENT_EXTRA_ARGS
