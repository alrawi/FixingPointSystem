{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alrawi/FixingPointSystem/contracts/schemas/test-config.schema.json",
  "title": "FixingPointSystem test configuration",
  "description": "Contract v0.3. Composes network, profile, load, timeline, criteria, and module settings. Names for ports and devices follow Open Traffic Generator vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "topology", "network", "profile", "load"],
  "properties": {
    "apiVersion": { "const": "fixingpoint.dev/v1alpha1" },
    "kind": { "const": "Test" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "topology": {
      "description": "app_sim emulates clients and servers; client_sim emulates clients against real servers; server_sim emulates servers for real clients.",
      "enum": ["app_sim", "client_sim", "server_sim"]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ports", "host_pools"],
      "properties": {
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "location"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "location": {
                "description": "Where the port runs. <agent>/<interface> pins the port to that one agent. A bare <interface> or */<interface> spreads the port across every agent that has the interface, and the controller splits the host pools of the port among those agents.",
                "type": "string",
                "pattern": "^(?:(?:[A-Za-z0-9_.-]+|\\*)/)?[A-Za-z0-9_.:-]+$"
              },
              "mtu": { "type": "integer", "minimum": 576, "maximum": 9216 }
            }
          }
        },
        "host_pools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/host_pool" }
        },
        "external_servers": {
          "description": "Real servers for client_sim topology.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "address": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "mix"],
      "properties": {
        "basis": { "enum": ["sessions", "bytes"] },
        "arrival": {
          "description": "Optional (v0.3). The distribution of the gaps between the starts of consecutive sessions of the whole run. A mix entry without its own arrival has no declared arrival process of its own. The declaration is the target that the realism check follows, and it adds no command for an agent.",
          "$ref": "#/$defs/arrival"
        },
        "size": {
          "description": "Optional (v0.3). The distribution of the payload sizes of the sessions of every mix entry that has no size of its own.",
          "$ref": "#/$defs/size"
        },
        "mix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario", "weight"],
            "properties": {
              "scenario": {
                "description": "Scenario reference as <module>/<scenario> or a bare scenario name that is unique among installed modules.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)?$"
              },
              "weight": { "type": "number", "exclusiveMinimum": 0 },
              "client_pool": { "$ref": "#/$defs/name" },
              "server_pool": { "$ref": "#/$defs/name" },
              "params": { "type": "object" },
              "arrival": {
                "description": "Optional (v0.3). The distribution of the gaps between the starts of consecutive sessions of this mix entry. It overrides profile.arrival for the entry.",
                "$ref": "#/$defs/arrival"
              },
              "size": {
                "description": "Optional (v0.3). The distribution of the payload sizes of this mix entry. Each direction that it names overrides the same direction of profile.size.",
                "$ref": "#/$defs/size"
              }
            }
          }
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "phases"],
      "properties": {
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["concurrent_sessions", "sessions_per_second", "throughput_bps", "simulated_users"] },
            "value": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "duration_s"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "duration_s": { "type": "number", "exclusiveMinimum": 0 },
              "shape": { "enum": ["linear", "step", "hold"], "default": "hold" }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "description": "Seed of every random choice in the run. When the configuration has no seed, the controller chooses a random nonzero seed and records it in the run.",
          "type": "integer",
          "minimum": 1
        },
        "warmup_s": { "type": "number", "minimum": 0 }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "op", "value"],
        "properties": {
          "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "op": { "enum": ["<", "<=", ">", ">=", "==", "!="] },
          "value": { "type": "number" },
          "where": {
            "description": "Label filter. The criterion checks only the series of the metric whose labels equal every value given here, for example application: dns. Each key must be a label that the metric catalog lists for the metric.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "modules": {
      "description": "Settings per module, keyed by module name. They hold for every scenario of the module in the test, while profile.mix params hold for one mix entry. The settings schema of the module manifest describes the settings object.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "settings": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,62}$" },
    "arrival": {
      "description": "A distribution of inter arrival times, written with the parameter names of the scenario delay (milliseconds unless the unit says otherwise). Constant, exponential, uniform, lognormal, and Pareto are the names that the realism check accepts for a target.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "ms"],
          "properties": {
            "dist": { "const": "constant" },
            "ms": { "type": "number", "exclusiveMinimum": 0 },
            "tolerance_ms": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "mean_ms"],
          "properties": {
            "dist": { "const": "exponential" },
            "mean_ms": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "min_ms", "max_ms"],
          "properties": {
            "dist": { "const": "uniform" },
            "min_ms": { "type": "number", "minimum": 0 },
            "max_ms": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "mu", "sigma"],
          "properties": {
            "dist": { "const": "lognormal" },
            "mu": { "type": "number" },
            "sigma": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["s", "ms"], "default": "s" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "alpha", "scale_ms"],
          "properties": {
            "dist": { "const": "pareto" },
            "alpha": { "type": "number", "exclusiveMinimum": 0 },
            "scale_ms": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "size_distribution": {
      "description": "A distribution of payload sizes in bytes. Lognormal parameters apply to the natural log of the size in bytes, and a Pareto distribution has the smallest value scale.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "value"],
          "properties": {
            "dist": { "const": "constant" },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "tolerance": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "mean"],
          "properties": {
            "dist": { "const": "exponential" },
            "mean": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "min", "max"],
          "properties": {
            "dist": { "const": "uniform" },
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "mu", "sigma"],
          "properties": {
            "dist": { "const": "lognormal" },
            "mu": { "type": "number" },
            "sigma": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dist", "alpha", "scale"],
          "properties": {
            "dist": { "const": "pareto" },
            "alpha": { "type": "number", "exclusiveMinimum": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "size": {
      "description": "Payload size distributions by direction. request is the client to server direction, response is the server to client direction, and both pools the two. A payload unit is one message of a message protocol, one datagram, or one whole direction of a session of a stream protocol, as the realism content check counts them.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "request": { "$ref": "#/$defs/size_distribution" },
        "response": { "$ref": "#/$defs/size_distribution" },
        "both": { "$ref": "#/$defs/size_distribution" }
      }
    },
    "host_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "role", "count"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "port": { "$ref": "#/$defs/name" },
        "role": { "enum": ["client", "server"] },
        "ipv4": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4]\\d|1?\\d?\\d)(\\.(25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}/(3[0-2]|[12]?\\d)$"
        },
        "ipv6": { "type": "string", "pattern": "^[0-9A-Fa-f:]+/(12[0-8]|1[01]\\d|[1-9]?\\d)$" },
        "count": { "type": "integer", "minimum": 1 },
        "gateway": { "type": "string" },
        "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "mac_base": { "type": "string", "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$" },
        "os_profile": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "anyOf": [ { "required": ["ipv4"] }, { "required": ["ipv6"] } ]
    }
  }
}
