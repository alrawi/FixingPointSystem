  "scenarios": [
    {
      "ref": "dns/lookup",
      "module": "dns",
      "source": "scenario: lookup\ndescription: One A record query and response over UDP. The payloads encode www.example.test in RFC 1035 wire format.\nvars:\n  server_port: 53\nflows:\n  - id: query\n    module: dns\n    l4: udp\n    client:\n      - connect: { port: \"{{ vars.server_port }}\" }\n      - send: \"{{ hex('12340100000100000000000003777777076578616d706c6504746573740000010001') }}\"\n      - expect: { min_bytes: 12, timeout_ms: 2000 }\n      - close: fin\n    server:\n      - accept: { port: \"{{ vars.server_port }}\" }\n      - expect: { min_bytes: 12, timeout_ms: 2000 }\n      - send: \"{{ hex('12348180000100010000000003777777076578616d706c6504746573740000010001c00c000100010000012c0004c0000201') }}\"\n      - close: fin\n",
      "digest": "sha256:082bd6140c4bb05a8cb32a5dd9e1f25669049aee72b214ab2b85a797a1b6cd91"
    },
    {
      "ref": "http1/web_browse",
      "module": "http1",
      "source": "scenario: web_browse\ndescription: A page view followed by think time and either a second page or an image fetch, on one keepalive connection.\nvars:\n  host: www.example.test\n  server_port: 8080\n  page_size: 18000\n  image_size: 52000\nflows:\n  - id: browse\n    module: http1\n    client:\n      - connect: { port: \"{{ vars.server_port }}\" }\n      - send: \"GET / HTTP/1.1\\r\\nHost: {{ vars.host }}\\r\\nAccept: text/html\\r\\n\\r\\n\"\n      - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 5000 }\n      - expect: { bytes: \"{{ vars.page_size }}\", timeout_ms: 5000 }\n      - delay: { dist: lognormal, mu: 3.0, sigma: 0.8, unit: ms }\n      - send: \"GET /logo.png HTTP/1.1\\r\\nHost: {{ vars.host }}\\r\\nAccept: image/png\\r\\n\\r\\n\"\n      - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 5000 }\n      - expect: { bytes: \"{{ vars.image_size }}\", timeout_ms: 5000 }\n      - close: fin\n    server:\n      - accept: { port: \"{{ vars.server_port }}\" }\n      - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 5000 }\n      - send: \"HTTP/1.1 200 OK\\r\\nContent-Type: text/html; charset=utf-8\\r\\nContent-Length: {{ vars.page_size }}\\r\\n\\r\\n{{ fill(vars.page_size) }}\"\n      - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 30000 }\n      - send: \"HTTP/1.1 200 OK\\r\\nContent-Type: image/png\\r\\nContent-Length: {{ vars.image_size }}\\r\\n\\r\\n{{ fill(vars.image_size) }}\"\n      - close: fin\n",
      "digest": "sha256:0f0bc3fcd1564fcedd5fcdafb6a387b05427f4a61e46097f9e787b2fbceaa588"
    },
    {
      "ref": "http1/web_get",
      "module": "http1",
      "source": "scenario: web_get\ndescription: One TCP connection that issues keepalive GET requests for objects of a fixed size.\nvars:\n  host: www.example.test\n  path: /index.html\n  server_port: 8080\n  requests: 4\n  body_size: 4096\n  user_agent: \"Mozilla/5.0 (X11; Linux x86_64) FixingPointSystem/0.1\"\nflows:\n  - id: page\n    module: http1\n    client:\n      - connect: { port: \"{{ vars.server_port }}\" }\n      - loop:\n          count: \"{{ vars.requests }}\"\n          do:\n            - send: \"GET {{ vars.path }} HTTP/1.1\\r\\nHost: {{ vars.host }}\\r\\nUser-Agent: {{ vars.user_agent }}\\r\\nAccept: */*\\r\\n\\r\\n\"\n            - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 5000 }\n            - expect: { bytes: \"{{ vars.body_size }}\", timeout_ms: 5000 }\n      - close: fin\n    server:\n      - accept: { port: \"{{ vars.server_port }}\" }\n      - loop:\n          count: \"{{ vars.requests }}\"\n          do:\n            - expect: { pattern: \"\\r\\n\\r\\n\", timeout_ms: 5000 }\n            - send: \"HTTP/1.1 200 OK\\r\\nServer: fps/0.1\\r\\nContent-Type: text/html\\r\\nContent-Length: {{ vars.body_size }}\\r\\n\\r\\n{{ fill(vars.body_size) }}\"\n      - close: fin\n",
      "digest": "sha256:5ce7e5a6664c4f5f6e44d3f0253ba90714ba3a1d588c8f7b8785e4683cb7b29b"
    }
  ],
